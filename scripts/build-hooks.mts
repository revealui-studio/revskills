#!/usr/bin/env node
/** Build the two RevKit-copied hook entrypoints as standalone Node bundles. */
import { build, type Metafile } from 'esbuild';
import { existsSync, readFileSync, readdirSync, realpathSync, renameSync, writeFileSync } from 'node:fs';
import { dirname, join, relative, resolve, sep } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const check = process.argv.slice(2).includes('--check');
if (process.argv.slice(2).some(arg => arg !== '--check')) throw new Error('usage: node scripts/build-hooks.mts [--check]');
const entries = [
  { source: 'scripts/src/snapshot-before-compact.cjs', output: 'scripts/snapshot-before-compact.js' },
  { source: 'scripts/src/sync-grok-token-budget.cjs', output: 'scripts/sync-grok-token-budget.js' },
] as const;
const noticePath = 'scripts/HOOK_BUNDLES_LICENSES.txt';

type PackageNotice = { name: string; version: string; license: string; location: string; files: { name: string; content: string }[] };
function bundledPackage(input: string): PackageNotice | null {
  const normalized = input.split(sep);
  if (!normalized.includes('node_modules')) return null;
  let dir = dirname(realpathSync(resolve(root, input)));
  while (dir !== dirname(dir)) {
    const manifest = join(dir, 'package.json');
    if (existsSync(manifest)) {
      const data: unknown = JSON.parse(readFileSync(manifest, 'utf8'));
      if (!data || typeof data !== 'object' || !('name' in data) || !('version' in data)) throw new Error(`invalid bundled package manifest: ${relative(root, manifest)}`);
      const pkg = data as { name: string; version: string; license?: string; homepage?: string; repository?: string | { url?: string } };
      const names = readdirSync(dir).filter(name => {
        const lower = name.toLowerCase();
        return lower.startsWith('license') || lower.startsWith('licence') || lower.startsWith('copying');
      }).sort();
      const files = names.filter(name => existsSync(join(dir, name))).map(name => ({ name, content: readFileSync(join(dir, name), 'utf8').trimEnd() }));
      const repository = typeof pkg.repository === 'string' ? pkg.repository : pkg.repository?.url;
      return { name: pkg.name, version: pkg.version, license: String(pkg.license ?? 'See upstream package'), location: String(pkg.homepage ?? repository ?? ''), files };
    }
    dir = dirname(dir);
  }
  throw new Error(`package manifest missing for bundled input: ${input}`);
}
function notices(metafiles: Metafile[]): string {
  const packages = new Map<string, PackageNotice>();
  for (const meta of metafiles) for (const input of Object.keys(meta.inputs)) {
    const pkg = bundledPackage(input);
    if (pkg) packages.set(`${pkg.name}@${pkg.version}`, pkg);
  }
  const sections = [...packages.values()].sort((a, b) => `${a.name}@${a.version}`.localeCompare(`${b.name}@${b.version}`)).map(pkg => [
    `${pkg.name}@${pkg.version}`,
    `License: ${pkg.license}`,
    pkg.location ? `Upstream: ${pkg.location}` : '',
    ...pkg.files.map(file => `--- ${file.name} ---\n${file.content}`),
  ].filter(Boolean).join('\n'));
  if (!sections.length) throw new Error('no third-party packages bundled; inspect esbuild metafile');
  return `Generated by node scripts/build-hooks.mts. Covers third-party packages embedded in the two RevKit hook bundles.\n\n${sections.join('\n\n==========\n\n')}\n`;
}
function reconcile(path: string, content: string): void {
  const target = resolve(root, path);
  if (check) {
    if (!existsSync(target) || readFileSync(target, 'utf8') !== content) throw new Error(`generated hook artifact is stale: ${path}`);
    return;
  }
  const temporary = `${target}.tmp-${process.pid}`;
  writeFileSync(temporary, content);
  renameSync(temporary, target);
}

const metafiles: Metafile[] = [];
for (const entry of entries) {
  const result = await build({
    absWorkingDir: root,
    entryPoints: [entry.source],
    outfile: entry.output,
    bundle: true,
    platform: 'node',
    format: 'cjs',
    target: 'node24',
    packages: 'bundle',
    sourcemap: false,
    legalComments: 'inline',
    metafile: true,
    write: false,
    logLevel: 'silent',
    define: { 'import.meta.url': JSON.stringify('revskills:bundled-library') },
    banner: { js: '// Generated by scripts/build-hooks.mts; edit scripts/src instead.\n' },
  });
  const output = result.outputFiles?.find(file => file.path === resolve(root, entry.output));
  if (!output || !result.metafile) throw new Error(`esbuild returned no artifact for ${entry.source}`);
  reconcile(entry.output, output.text);
  metafiles.push(result.metafile);
}
reconcile(noticePath, notices(metafiles));
console.log(`hook bundles ${check ? 'checked' : 'built'}: ${entries.length} entrypoints`);
